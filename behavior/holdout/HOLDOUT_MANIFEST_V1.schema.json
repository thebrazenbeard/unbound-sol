{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "UNBOUND_SOL_BEHAVIOR_HOLDOUT_MANIFEST_V1",
  "title": "Sol Behavior Holdout Custody Manifest V1",
  "type": "object",
  "required": [
    "schema",
    "manifest_id",
    "created_at",
    "status",
    "candidate_subject",
    "targets",
    "case_count",
    "case_set_artifact",
    "scoring_key_artifact",
    "exposure_lineage",
    "custody_evidence",
    "blind_transfer_use_state",
    "invalidation_reasons",
    "claim_semantics",
    "claim_ceiling"
  ],
  "properties": {
    "schema": {
      "const": "UNBOUND_SOL_BEHAVIOR_HOLDOUT_MANIFEST_V1"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "FROZEN_UNEXPOSED",
        "EXPOSED_REGRESSION_ONLY",
        "INVALIDATED"
      ]
    },
    "candidate_subject": {
      "type": "object",
      "required": [
        "subject_id",
        "binding_kind",
        "binding"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "binding_kind": {
          "enum": [
            "MODEL_ARTIFACT_DIGEST",
            "RUNTIME_REF",
            "SOURCE_COMMIT",
            "COMPOSITE_SUBJECT",
            "OTHER"
          ]
        },
        "binding": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "case_count": {
      "type": "integer",
      "minimum": 1
    },
    "case_set_artifact": {
      "$ref": "#/$defs/hidden_artifact"
    },
    "scoring_key_artifact": {
      "$ref": "#/$defs/hidden_artifact"
    },
    "exposure_lineage": {
      "$ref": "#/$defs/exposure_lineage"
    },
    "custody_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/custody_evidence"
      }
    },
    "blind_transfer_use_state": {
      "enum": [
        "ELIGIBLE_TO_ATTEMPT",
        "REGRESSION_ONLY",
        "INVALID"
      ]
    },
    "invalidation_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_semantics": {
      "const": "HOLDOUT_CUSTODY_DECLARATION_NOT_PROOF_OF_NONEXPOSURE"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hidden_artifact": {
      "type": "object",
      "required": [
        "sha256",
        "storage_class",
        "public_content"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "storage_class": {
          "enum": [
            "PRIVATE_EXTERNAL",
            "SEALED_EXTERNAL"
          ]
        },
        "public_content": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "exposure_lineage": {
      "type": "object",
      "required": [
        "restored_state",
        "training_data",
        "tuning_feedback",
        "prior_evaluation_feedback",
        "candidate_pre_access"
      ],
      "properties": {
        "restored_state": {
          "type": "boolean"
        },
        "training_data": {
          "type": "boolean"
        },
        "tuning_feedback": {
          "type": "boolean"
        },
        "prior_evaluation_feedback": {
          "type": "boolean"
        },
        "candidate_pre_access": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "custody_evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "evidence_kind",
        "binding"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_kind": {
          "enum": [
            "IMMUTABLE_REF",
            "CONTENT_DIGEST",
            "SIGNED_RECEIPT",
            "SEALED_STORE_RECEIPT",
            "OTHER"
          ]
        },
        "binding": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
