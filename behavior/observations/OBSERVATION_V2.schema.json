{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "UNBOUND_SOL_BEHAVIOR_OBSERVATION_V2",
  "title": "Sol behavior observation V2",
  "type": "object",
  "required": [
    "schema",
    "id",
    "recorded_at",
    "recorded_at_binding",
    "event_time",
    "event_time_semantics",
    "observation_class",
    "summary",
    "observed_behavior",
    "error_characterization",
    "causal_diagnosis",
    "relevant_targets",
    "evidence_bindings",
    "promotion_semantics",
    "public_safe",
    "result_semantics"
  ],
  "properties": {
    "schema": {
      "const": "UNBOUND_SOL_BEHAVIOR_OBSERVATION_V2"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at_binding": {
      "type": "string",
      "minLength": 1
    },
    "event_time": {
      "$ref": "#/$defs/time_point"
    },
    "event_time_semantics": {
      "const": "EVENT_TIME_DISTINCT_FROM_RECORD_TIME_NO_INFERENCE"
    },
    "observation_class": {
      "enum": [
        "CORRECTED_ERROR",
        "SELF_CORRECTED_ERROR",
        "RECOVERY_BEFORE_FINAL_CLAIM",
        "SUCCESS",
        "MIXED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "observed_behavior": {
      "type": "string",
      "minLength": 1
    },
    "error_characterization": {
      "type": [
        "string",
        "null"
      ]
    },
    "causal_diagnosis": {
      "type": "object",
      "required": [
        "status",
        "claim",
        "evidence_bindings"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNDETERMINED",
            "SUPPORTED",
            "NOT_APPLICABLE"
          ]
        },
        "claim": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_bindings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "relevant_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "promotion_semantics": {
      "type": "object",
      "required": [
        "want_admission",
        "behavior_target_admission",
        "training_admission"
      ],
      "properties": {
        "want_admission": {
          "const": false
        },
        "behavior_target_admission": {
          "const": false
        },
        "training_admission": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "public_safe": {
      "const": true
    },
    "result_semantics": {
      "const": "OBSERVED_BEHAVIOR_DIAGNOSTIC_ONLY_NOT_TARGET_AUTHORITY"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "time_point": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "const": "EXACT"
            },
            "value": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "earliest",
            "latest"
          ],
          "properties": {
            "state": {
              "const": "BOUNDED"
            },
            "earliest": {
              "type": "string",
              "format": "date-time"
            },
            "latest": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state",
            "label"
          ],
          "properties": {
            "state": {
              "const": "APPROXIMATE"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "earliest": {
              "type": "string",
              "format": "date-time"
            },
            "latest": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "UNKNOWN"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
